{
  "name": "dsh-qq-bridge",
  "version": "1.0.7-conversation.1",
  "description": "通到 QQ：DSH 里的 AI 伙伴和 QQ 双向互通 —— 它说完话自动发到 QQ，你在 QQ 里说的话自动转进 DSH。走 OneBot 11 HTTP（SnowLuma / NapCat 都行）。这是 Yuuyuko-uu/dsh-qq-bridge 的改造版，把 QQ 消息的身份信息一起交给 agent。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.upstream.md",
    "CHANGELOG.md",
    "CHANGELOG.conversation.md",
    "LICENSE",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "upstream": "https://github.com/Yuuyuko-uu/dsh-qq-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bird-ux11/dsh-qq-bridge-conversation.git"
  },
  "homepage": "https://github.com/Bird-ux11/dsh-qq-bridge-conversation#readme",
  "bugs": {
    "url": "https://github.com/Bird-ux11/dsh-qq-bridge-conversation/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
